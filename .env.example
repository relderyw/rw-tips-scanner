# URL da ponte Python. As credenciais da IQ Option são informadas na tela do app.
VITE_BRIDGE_URL=http://localhost:8000

# Firebase Web app configuration (Firebase Console > Project settings > Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_ADMIN_EMAIL=

# ─── RW TIPS SCANNER — bot_scanner.py ───────────────────────────────────────
IQ_EMAIL=seu_email@exemplo.com
IQ_PASSWORD=sua_senha_iq_option
IQ_ACCOUNT_TYPE=PRACTICE          # PRACTICE (demo) ou REAL

# Telegram (obter token via @BotFather, chat_id via @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Parâmetros do scanner (opcionais — têm valores padrão)
DEFAULT_STAKE=2.0                  # valor por entrada em USD
DEFAULT_EXPIRY=1                   # expiração em minutos
DEFAULT_MIN_CONF=75                # confiança mínima % (50–99)
AUTO_TRADE=false                   # true = entradas automáticas
SCAN_INTERVAL=60                   # segundos entre ciclos de scan
MAX_ASSETS=60                      # máx de ativos analisados por ciclo
MAX_DAILY_TRADES=30                # stop de trades diários
MAX_DAILY_LOSS=50.0                # stop loss diário em USD
