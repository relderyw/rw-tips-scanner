# =====================================================================
# Ponte RW TIPS Scanner ↔ IQ Option (contas reais, SOMENTE LEITURA)
# As credenciais IQ são informadas individualmente na tela "Conectar IQ".
# Não são configuradas aqui nem salvas no banco de candles.
# =====================================================================

# --- Persistência ---
DB_PATH=./data/candles.db
RETENTION_HOURS=200
BACKFILL_HOURS=168

# --- CORS ---
# Origens permitidas no CORS e no upgrade do WebSocket. Separe por vírgula.
CORS_ORIGINS=http://localhost:5173

# Firebase Admin SDK (server-side only; never place service-account data in VITE_* variables)
FIREBASE_PROJECT_ID=rw-tips
FIREBASE_ADMIN_EMAIL=
# Set one of these on the bridge host:
# FIREBASE_ADMIN_CREDENTIALS=path/to/service-account.json
# FIREBASE_ADMIN_CREDENTIALS_JSON={"type":"service_account",...}

# Telegram destination shared by all Radar signals (server-side secrets only)
TELEGRAM_BOT_TOKEN=replace-with-a-new-token-from-BotFather
TELEGRAM_CHAT_ID=replace-with-your-channel-chat-id

# --- Streaming em tempo real ---
# Intervalo (s) do watchdog que detecta streams "stale" / mercado fechado
WATCHDOG_INTERVAL=10
# Margem extra (acima de 2 × timeframe) para considerar um stream stale
STALE_MARGIN_SECONDS=30
# Intervalo (s) de envio da mensagem "health" pelo WebSocket
WS_HEALTH_INTERVAL=5
# Intervalo (min) de refresh dos payouts via get_actives()
PAYOUT_REFRESH_MINUTES=5
